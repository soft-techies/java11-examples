pipeline {
    agent any

    stages {

        stage('Debug Info') {
            steps {
                echo 'Pipeline started'
                sh 'whoami'
                sh 'pwd'
            }
        }

        stage('Install Maven & JDK') {
            steps {
                sh '''
                echo "Installing tools..."
                sudo apt update -y
                sudo apt install -y maven openjdk-17-jdk
                '''
            }
        }

        stage('Verify Installation') {
            steps {
                sh '''
                echo "Checking versions..."
                java -version
                mvn -version
                '''
            }
        }

        stage('Clone Repository') {
            steps {
                git 'https://github.com/hellokaton/java11-examples.git'
            }
        }
    }
}
